{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechnicalSignal strategy config",
  "type": "object",
  "required": [
    "strategy_type",
    "signal_type",
    "orderQuantity",
    "contract",
    "ledgerPath",
    "ledgerContextCollection"
  ],
  "additionalProperties": true,
  "properties": {
    "strategy_type": {
      "type": "string",
      "enum": ["TechnicalSignal", "TECH"]
    },
    "signal_type": {
      "type": "string",
      "minLength": 1
    },
    "fastWindow": {
      "type": "integer",
      "minimum": 1
    },
    "slowWindow": {
      "type": "integer",
      "minimum": 2
    },
    "middleWindow": {
      "type": "integer",
      "minimum": 1
    },
    "trendWindow": {
      "type": "integer",
      "minimum": 1
    },
    "bandStddev": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rsiPeriod": {
      "type": "integer",
      "minimum": 1
    },
    "divergenceLookback": {
      "type": "integer",
      "minimum": 1
    },
    "openingRangeBars": {
      "type": "integer",
      "minimum": 1
    },
    "pivotWindow": {
      "type": "integer",
      "minimum": 1
    },
    "donchianWindow": {
      "type": "integer",
      "minimum": 1
    },
    "entryMode": {
      "type": "string",
      "enum": ["breakout", "mean_reversion", "meanReversion", "meanreversion", "reversion"]
    },
    "useAtrStop": {
      "type": "boolean"
    },
    "atrWindow": {
      "type": "integer",
      "minimum": 1
    },
    "momentumLookback": {
      "type": "integer",
      "minimum": 1
    },
    "allowShort": {
      "type": "boolean"
    },
    "channelWindow": {
      "type": "integer",
      "minimum": 1
    },
    "exitWindow": {
      "type": "integer",
      "minimum": 1
    },
    "meanReversionWindow": {
      "type": "integer",
      "minimum": 1
    },
    "entryZScore": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "exitZScore": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "orderQuantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "contract": {
      "$ref": "#/definitions/contract"
    },
    "price_contract": {
      "$ref": "#/definitions/contract"
    },
    "ledgerPath": {
      "type": "string",
      "minLength": 1
    },
    "ledgerContextCollection": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "contract": {
      "type": "object",
      "required": ["symbol", "secType", "currency", "exchange"],
      "additionalProperties": true,
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "secType": {
          "type": "string",
          "enum": ["STOCK", "OPTION", "FUTURE", "CURRENCY", "CRYPTO"]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "exchange": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
